{
  "name": "dev-companion",
  "version": "0.5.0",
  "private": true,
  "description": "A local-first AI development companion for Windows. Human-controlled, permission-based assistance.",
  "author": "Yash Parmar",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:win": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.15.2",
    "ws": "^8.22.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "in.devcompanion.desktop",
    "productName": "Dev Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.4"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.4"
    }
  }
}
